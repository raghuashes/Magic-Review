# ==============================================================================
# MAGIC REVIEW - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# Database (PostgreSQL 16)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/magicreview
SPRING_DATASOURCE_USERNAME=magicuser
SPRING_DATASOURCE_PASSWORD=magicpassword

# JWT Security
# Must be at least 256 bits (32+ bytes Base64-encoded or raw string)
JWT_SECRET=c2VjdXJlUmFuZG9tS2V5Rm9yTWFnaWNSZXZpZXdCYWNrZW5kQXBwbGljYXRpb24yMDI2U2FhUw==
JWT_EXPIRATION_MS=86400000

# Google Gemini API
# Optional: If left blank, Magic Review gracefully uses its built-in DemoReviewGenerator
GEMINI_API_KEY=

# Application & CORS URLs
APP_FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8080
